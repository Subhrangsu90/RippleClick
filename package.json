{
	"name": "ripple-click",
	"version": "1.0.0",
	"description": "A polished Windows tray app that makes clicks easy to follow during demos, reviews, training, and screen sharing.",
	"main": "src/main.js",
	"scripts": {
		"start": "electron .",
		"dev": "node scripts/dev-watch.js",
		"dev:once": "electron .",
		"package:win": "electron-builder --win nsis",
		"package:win:portable": "electron-builder --win portable",
		"package:win:debug": "npm run package:win -- --config.compression=store"
	},
	"keywords": [
		"windows",
		"screen-sharing",
		"click-highlight",
		"electron"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"electron": "^42.0.0",
		"electron-builder": "^24.13.3"
	},
	"build": {
		"appId": "com.rippleclick.app",
		"productName": "RippleClick",
		"files": [
			"build/icon.ico",
			"src/**/*",
			"package.json"
		],
		"afterPack": "scripts/after-pack.js",
		"directories": {
			"buildResources": "build"
		},
		"win": {
			"icon": "build/icon.ico",
			"signAndEditExecutable": true,
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"artifactName": "${productName}-v${version}.exe"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"installerIcon": "build/icon.ico",
			"uninstallerIcon": "build/icon.ico",
			"artifactName": "${productName}-Setup-v${version}.exe"
		},
		"portable": {
			"artifactName": "${productName}-v${version}.exe"
		},
		"asar": true,
		"asarUnpack": false,
		"compression": "maximum",
		"electronLanguages": [
			"en-US"
		],
		"removePackageKeywords": true,
		"publish": null,
		"electronVersion": "42.3.0"
	}
}
